{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/layout/*": ["./src/components/layout/*"],
      "@/sections/*": ["./src/components/sections/*"],
      "@/shared/*": ["./src/components/shared/*"]
    },
    "jsx": "react-jsx",
    "allowJs": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
